# Dependencies
node_modules/

# Build artifacts (rebuilt inside Docker)
# Nota: no ignorar src/ — el stage builder hace COPY src/ y compila; la imagen
# final (runner) solo recibe dist/, no las fuentes.
dist/

# Environment files — NEVER en la imagen
.env
.env.*
!.env.example

# Keys database — datos del host, no de la imagen
*.db.json
data/
data-dev/

# Logs
*.log
logs/

# Test files
coverage/

# Dev tools
.vscode/
.idea/
*.md

# Git
.git/
.gitignore

# OS files
.DS_Store
Thumbs.db

# CI
.github/
