    {
      "name": "Managed Keys Flow",
      "item": [
        {
          "name": "POST /crypto/keys/managed/create (RSA)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.expect(json.ok).to.eql(true);",
                  "pm.collectionVariables.set('managedKeyId', json.keyId);",
                  "pm.collectionVariables.set('managedPublicKey', json.publicKey);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-api-key", "value": "{{apiKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"rsa\",\n  \"modulusLength\": 2048\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/crypto/keys/managed/create",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "crypto", "keys", "managed", "create"]
            }
          }
        },
        {
          "name": "GET /crypto/keys/managed",
          "request": {
            "method": "GET",
