            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-api-key", "value": "{{apiKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"keyId\": \"{{managedKeyId}}\",\n  \"plaintext\": \"{{samplePlaintext}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/crypto/managed/hybrid/encrypt",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "crypto", "managed", "hybrid", "encrypt"]
