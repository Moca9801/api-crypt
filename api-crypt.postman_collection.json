              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.expect(json.ok).to.eql(true);",
                  "pm.collectionVariables.set('managedEncryptedAesKey', json.encryptedAesKey);",
                  "pm.collectionVariables.set('managedIv', json.iv);",
                  "pm.collectionVariables.set('managedAuthTag', json.authTag);",
                  "pm.collectionVariables.set('managedCiphertext', json.ciphertext);"
