{
  "name": "api-crypt",
  "version": "1.0.0",
  "description": "API for cryptographic operations for web services",
  "main": "index.js",
  "scripts": {
    "test": "npm run build && cross-env API_KEY=test-api-key NODE_ENV=test node --test \"dist/tests/**/*.test.js\"",
    "dev": "nodemon --exec ts-node src/index.ts",
    "start": "ts-node src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build -t api-crypt:latest .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up",
    "docker:logs": "docker compose logs -f api-crypt"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Moca9801/api-crypt.git"
  },
  "keywords": [
    "crypto",
    "encrypt",
    "decrypt",
    "sign",
    "hash"
  ],
  "author": "Angel Israel Moreno Castellanos",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Moca9801/api-crypt/issues"
  },
  "homepage": "https://github.com/Moca9801/api-crypt#readme",
  "dependencies": {
    "@types/express": "^4.17.21",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "morgan": "^1.10.0",
    "nodemon": "^3.1.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/node": "^25.6.0",
    "@types/supertest": "^7.2.0",
    "cross-env": "^10.1.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
