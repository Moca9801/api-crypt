PORT=3000
API_KEY=change-this-in-production

# ── Key Vault ────────────────────────────────────────────────────────────────
# 64 hex characters = 32 bytes. REQUIRED in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=

# Path to the encrypted keys database file (relative to project root).
# The file stores managed key metadata + AES-256-GCM encrypted private keys.
KEYS_DB_PATH=keys.db.json

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. REQUIRED in production.
# Example: ALLOWED_ORIGINS=https://myapp.com,https://admin.myapp.com
# In development, defaults to localhost:3000/5173/4200 if not set.
ALLOWED_ORIGINS=

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ── Legacy Routes ─────────────────────────────────────────────────────────────
# Set to true to disable raw key-material routes (recommended in production).
# Automatically true when NODE_ENV=production.
DISABLE_LEGACY_CRYPTO_ROUTES=false
