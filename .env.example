# ── api-crypt — Variables de Entorno ─────────────────────────────────────────
# Copia este archivo como .env y rellena los valores.
# NUNCA comitees .env con secretos reales.

# ── Entorno ───────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Autenticación ─────────────────────────────────────────────────────────────
# API key para acceder a todos los endpoints criptográficos.
# REQUERIDA — el servidor no inicia sin este valor fuera de development.
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=your-api-key-here

# ── Clave maestra de cifrado ──────────────────────────────────────────────────
# Protege las claves privadas almacenadas en disco (AES-256-GCM).
# REQUERIDA en producción. En desarrollo se usa una clave cero (insegura).
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MASTER_KEY=

# ── Almacenamiento de claves ──────────────────────────────────────────────────
KEYS_DB_PATH=keys.db.json

# ── Red ───────────────────────────────────────────────────────────────────────
PORT=3000
HOST=localhost

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ── Métricas ──────────────────────────────────────────────────────────────────
# IPs autorizadas a scrapear /metrics. Vacío = localhost permitido en dev.
# METRICS_ALLOWED_IPS=127.0.0.1,10.0.0.5

# ── Rotación automática de claves ─────────────────────────────────────────────
# ROTATION_CHECK_INTERVAL_MS=3600000

# ── Rutas legacy ─────────────────────────────────────────────────────────────
# DISABLE_LEGACY_CRYPTO_ROUTES=false
